# Для Dokploy: вставьте эти переменные во вкладку Environment сервиса Compose.
# Для локального запуска: cp .env.example .env и заполните. .env не коммитить.

# ─────────────────────────────────────────────
# PostgreSQL (отдельный сервис в проекте Dokploy)
# host = "Internal Host" из карточки базы в Dokploy, не localhost
# ─────────────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@INTERNAL_HOST:5432/DBNAME

# ─────────────────────────────────────────────
# S3 / MinIO (отдельный Compose-сервис Dokploy, образ pgsty/minio)
# S3_ENDPOINT   — внутренний адрес по имени сервиса `minio` (порт 9000, S3 API), не публичный домен
# S3_PUBLIC_URL — публичный домен API MinIO (порт 9000) + /бакет
# Ключ: создайте в консоли MinIO отдельный access key на бакет, не root-пользователя
# ─────────────────────────────────────────────
S3_BUCKET=media
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://s3.example.com/media

# ─────────────────────────────────────────────
# Kodik API
# ─────────────────────────────────────────────
KODIK_TOKEN=YOUR_KODIK_TOKEN_HERE
KODIK_TRANSLATION_ID=609
KODIK_LIMIT=100
KODIK_DELAY=0.25
KODIK_TIMEOUT=60
KODIK_RETRIES=5

# ─────────────────────────────────────────────
# Статус релиза (anons/ongoing/released) — необязательно.
# Колонка content.release_status создаётся миграцией CMS. Переменная нужна,
# только если в вашей схеме колонка называется иначе.
# ─────────────────────────────────────────────
# RELEASE_STATUS_COLUMN=release_status

# ─────────────────────────────────────────────
# Сброс кэша сайта после load / update-ongoing (необязательно)
# REVALIDATE_URL    — адрес сайта изнутри dokploy-network (alias сервиса web) или публичный https://otakuum.ru
# REVALIDATE_SECRET — тот же секрет, что REVALIDATE_SECRET у web и CMS (openssl rand -hex 32)
# Без обеих переменных шаг пропускается, пайплайн работает как раньше.
# ─────────────────────────────────────────────
REVALIDATE_URL=http://movhub-web:3000
REVALIDATE_SECRET=
